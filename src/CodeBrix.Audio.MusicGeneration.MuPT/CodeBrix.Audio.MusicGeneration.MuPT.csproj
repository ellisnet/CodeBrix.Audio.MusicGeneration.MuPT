<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeBrix.Audio.MusicGeneration.MuPT</RootNamespace>
    <AssemblyName>CodeBrix.Audio.MusicGeneration.MuPT</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!-- NuGet package properties -->
  <PropertyGroup>
    <PackageId>CodeBrix.Audio.MusicGeneration.MuPT.ApacheLicenseForever</PackageId>
    <Product>CodeBrix.Audio.MusicGeneration.MuPT</Product>
    <Title>CodeBrix.Audio.MusicGeneration.MuPT</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>MuPT Q4_K_M GGUF music model, with explicit lazy registration for CodeBrix.Audio.MusicGeneration. Model files and Apache-2.0 notices copy transitively to application build and publish output. No runtime download, Python or ModelManager is required.</Description>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Audio.MusicGeneration.MuPT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Audio.MusicGeneration.MuPT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>audio;midi;music;music-generation;model;mupt;CodeBrix</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <ModelArtifactsDirectory Condition="'$(ModelArtifactsDirectory)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'staging', 'output'))</ModelArtifactsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Audio.MusicGeneration.MitLicenseForever" Version="1.0.266.178" />
  </ItemGroup>

  <ItemGroup>
    <_ModelArtifact Include="$(ModelArtifactsDirectory)MuPT-v1-8192-190M-Q4_K_M.gguf" ExpectedHash="6de624aa478f7beb99d025334e9655e2f782c6441a5b1ec108d2df84bfff4983" />
    <None Include="@(_ModelArtifact)" Pack="true" PackagePath="assets/" />
    <None Update="buildTransitive/net10.0/CodeBrix.Audio.MusicGeneration.MuPT.ApacheLicenseForever.targets" Pack="true" PackagePath="buildTransitive/net10.0/CodeBrix.Audio.MusicGeneration.MuPT.ApacheLicenseForever.targets" />
    <None Include="../../icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="assets/THIRD-PARTY-NOTICES.txt" />
    <None Include="../../LICENSE" Pack="true" PackagePath="assets/" />
    <None Include="../../MODEL-CARD.md" Pack="true" PackagePath="assets/MODEL-CARD.md" />
    <None Include="../../MODEL-PROVENANCE.json" Pack="true" PackagePath="assets/MODEL-PROVENANCE.json" />
  </ItemGroup>

  <Target Name="ValidateModelArtifacts" BeforeTargets="PrepareForBuild;GenerateNuspec">
    <Error Condition="!Exists('%(_ModelArtifact.Identity)')" Text="Missing model artifact: %(_ModelArtifact.Identity). Run dotnet run --project tools/ModelStager -c Release from the repository root." />
    <Error Condition="!Exists('../../MODEL-CARD.md')" Text="Missing pinned MODEL-CARD.md; restore the model notices before packaging." />
    <Error Condition="!Exists('../../MODEL-PROVENANCE.json')" Text="Missing MODEL-PROVENANCE.json; run tools/ModelStager before packaging." />
    <GetFileHash Files="@(_ModelArtifact)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedModelArtifact" />
    </GetFileHash>
    <Error Condition="'%(_HashedModelArtifact.FileHash)' != '%(_HashedModelArtifact.ExpectedHash)'" Text="Model artifact hash differs from the accepted provenance: %(_HashedModelArtifact.Identity). Review the staging result before packaging." />
  </Target>

</Project>
