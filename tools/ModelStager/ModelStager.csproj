<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ModelStager</AssemblyName>
    <RootNamespace>CodeBrix.Audio.MusicGeneration.MuPT.ModelStager</RootNamespace>
    <Description>Reproduces this repository's shipped model artifact from upstream, on a machine that has nothing but .NET installed.</Description>
  </PropertyGroup>

  <!--
    The ONLY project in this repository that references CodeBrix.Ollama.ModelManager, and it is not
    packable: the store, the conversion and the quantization belong to the staging step and never to
    anything that ships. Both packages come from nuget.org; nothing here reaches anywhere else.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Ollama.ModelManager.MitLicenseForever" Version="1.0.262.1044" />
    <PackageReference Include="CodeBrix.Ollama.ModelRunner.MitLicenseForever" Version="1.0.262.1044" />
  </ItemGroup>

</Project>
